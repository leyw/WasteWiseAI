# ============================================================
# WasteWise AI — Backend Environment Variables (CONTOH)
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke version control.
# ============================================================

# --- Keamanan ---
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite:///./wastewise.db

# --- AI Provider ---
# Pilihan: mock | gemini | openai
AI_PROVIDER=your_api_key
AI_API_KEY=

# Model Gemini yang digunakan (harus mendukung vision/multimodal)
# Rekomendasi: gemini-2.5-flash | gemini-2.5-flash-lite | gemini-1.5-flash
GEMINI_MODEL=models/gemini-3-flash-preview

# --- Upload ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
